# Neon Postgres connection string.
# Vercel Dashboard -> Storage -> Neon integration -> connection string
# (or Neon console -> project -> connection string)
DATABASE_URL=

# Single shared password used to unlock the app (no account system).
# Choose a high-entropy value (16+ chars recommended).
APP_PASSWORD=

# Random secret used to encrypt the iron-session cookie.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# random >=16 chars; set in Vercel project env + local .env.local. Vercel
# auto-sends it as Authorization: Bearer on cron invocations to /api/cron/auto-log.
CRON_SECRET=
